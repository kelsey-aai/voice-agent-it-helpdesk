# Required: one key covers speech-to-text, LLM Gateway, and text-to-speech.
# Get yours at https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Optional: the port bridge_server.py listens on (default 8000)
PORT=8000

# ── Telephony transfer (optional) ────────────────────────────────────────────
# Without these, escalate_to_human logs the hand-off instead of dialing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Fallback number dialed when a queue below isn't set (E.164, e.g. +14155551234)
HUMAN_TRANSFER_NUMBER=
# Per-queue numbers (optional; override the fallback above)
QUEUE_SERVICE_DESK=
QUEUE_IDENTITY_ACCESS=
QUEUE_NETWORK=
QUEUE_SECURITY=
QUEUE_ON_CALL=

# ── Real KB / ITSM (optional) ────────────────────────────────────────────────
# Only needed if you swap the in-memory mocks in integrations.py for the
# production versions at the bottom of that file.
KB_SEARCH_URL=
ITSM_API_URL=
ITSM_TOKEN=
